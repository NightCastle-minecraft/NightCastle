# Скопировать в .env на сервере. Пароль RCON лежит не здесь, а в secrets/ (bin/init-secrets.sh).
DOMAIN=example.com
# Название сервера: в письмах и как имя отправителя. На сайте меняется в админке.
SITE_NAME=MyServer
# Адрес для игроков в приветственном письме (пусто = DOMAIN)
GAME_ADDRESS=
# Heap Java для SMP. Лимит контейнера 6500m: подгоните оба значения под память своей машины.
SMP_MEMORY=5G

# Три базы MySQL/MariaDB (D14): аккаунт живёт в базе crc32(lower(ник)) % 3 + 1, сайт в DB1.
# Реальные значения только в .env на сервере (chmod 600), держите их только здесь.
DB1_HOST=
DB1_NAME=
DB1_USER=
DB1_PASSWORD=
DB2_HOST=
DB2_NAME=
DB2_USER=
DB2_PASSWORD=
DB3_HOST=
DB3_NAME=
DB3_USER=
DB3_PASSWORD=
